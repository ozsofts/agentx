{
  "name": "pi-desktop-prototype",
  "version": "0.0.0",
  "description": "Agentx, a local cross-platform desktop agent powered by Pi",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4174 --strictPort",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "test": "node --test",
    "test:desktop": "npm run build && node scripts/start-desktop.mjs scripts/smoke-desktop.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node scripts/start-desktop.mjs",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "mermaid": "^11.17.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "vite": "6.4.2"
  },
  "build": {
    "appId": "com.piagent.desktop",
    "productName": "Agentx",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
